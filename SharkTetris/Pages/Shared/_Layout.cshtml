<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SharkTetris</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SharkTetris.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323:wght@400&display=swap" rel="stylesheet">
</head>
<body>
    <style>
        body { background: #000820; }
        header { border-bottom: 3px solid #00f0f0; background: rgba(0,4,20,0.92); }
        .retro-nav { display:flex; align-items:center; gap:2rem; padding:0.6rem 1.5rem; }
        .retro-brand { font-family:'Press Start 2P',monospace; font-size:1rem; color:#00f0f0; text-decoration:none; text-shadow:0 0 10px #00f0f0; }
        .retro-brand:hover { color:#fff; }
        .retro-links { display:flex; gap:1.5rem; list-style:none; margin:0; padding:0; }
        .retro-links a { font-family:'Press Start 2P',monospace; font-size:0.55rem; color:#888; text-decoration:none; letter-spacing:0.05em; }
        .retro-links a:hover { color:#00f0f0; }
    </style>
    <header>
        <nav class="retro-nav">
            <a class="retro-brand" asp-area="" asp-page="/Index">🦈 SHARKTRIS</a>
            <ul class="retro-links">
                <li><a asp-area="" asp-page="/Index">HOME</a></li>
                <li><a asp-area="" asp-page="/Privacy">PRIVACY</a></li>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SharkTetris - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>